# Sample env for docker-compose deployment.
# Copy this file to `.env` next to docker-compose.yml and edit values.

# Admin login (change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-strong-password

# JWT signing key (generate: `python -c "import secrets; print(secrets.token_hex(32))"`)
JWT_SECRET=replace-me-with-64-hex-chars

# Which port the manager UI listens on
FRONTEND_PORT=8080

# Host directory that becomes the workspace inside the container.
# All your Python projects live under here.
HOST_WORKSPACE=./workspace
